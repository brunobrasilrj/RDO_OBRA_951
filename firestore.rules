rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permit read and write to collaborative RDOs collection
    match /rdos/{rdoId} {
      allow read, write: if true;
    }
    
    // Permit user accounts management
    match /users/{userId} {
      allow read, write: if true;
    }

    // Permit access and activity audit logs
    match /access_logs/{logId} {
      allow read, write: if true;
    }
  }
}
